NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Recommended for /api/admin (server only). Copy to .env.local locally.
# In Vercel, enable for Production, Preview (all branches), and Development.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Existing public clients still use these. The admin proxy also accepts them
# as a fallback when the server-only variables above are not set.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Same value as the Supabase Edge Function secret ADMIN_PROXY_SECRET
# (openssl rand -hex 32). Never NEXT_PUBLIC_.
ADMIN_PROXY_SECRET=
