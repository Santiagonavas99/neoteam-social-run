NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Recommended for /api/admin (server only). Copy to .env.local locally.
# In Vercel, enable for Production, Preview (all branches), and Development.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Existing public clients still use these. The admin proxy also accepts them
# as a fallback when the server-only variables above are not set.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google Wallet · Event Ticket
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# Base64 of the full PEM private key, including BEGIN/END PRIVATE KEY lines.
GOOGLE_WALLET_PRIVATE_KEY_BASE64=
GOOGLE_WALLET_CLASS_SUFFIX=neoteam_social_run_2026
GOOGLE_WALLET_ORIGIN=http://localhost:3000

# Apple Wallet · PassKit
APPLE_PASS_TYPE_ID=pass.com.example.neoteam.socialrun
APPLE_TEAM_ID=
# Base64-encoded certificate/key files. Keep them server-side only.
APPLE_WWDR_CERT_BASE64=
APPLE_PASS_CERT_BASE64=
APPLE_PASS_KEY_BASE64=
APPLE_PASS_KEY_PASSPHRASE=
